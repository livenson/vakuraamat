; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Vakuraamat"
config/description="Time-travel farming/hunting/trading game on real Estonian terrain (Maa-amet open data). Locations and stories are site packs under sites/."
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
Sites="*res://scripts/autoload/sites.gd"
Locator="*res://scripts/autoload/locator.gd"
SpacetimeDB="*res://spacetime_bindings/schema/spacetime_autoload.gd"
Ledger="*res://scripts/autoload/ledger.gd"
Friends="*res://scripts/autoload/friends.gd"
Reporter="*res://scripts/autoload/reporter.gd"
DevChannel="*res://scripts/autoload/dev_channel.gd"
TimelineState="*res://scripts/autoload/timeline_state.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
Inventory="*res://scripts/autoload/inventory.gd"
Journal="*res://scripts/autoload/journal.gd"
Narrative="*res://scripts/autoload/narrative.gd"
GameState="*res://scripts/autoload/game_state.gd"
Farming="*res://scripts/farming/farming.gd"
Hunting="*res://scripts/hunting/hunting.gd"
Trading="*res://scripts/trading/trading.gd"
Manors="*res://scripts/base_building/manors.gd"
WindowMode="*res://scripts/autoload/window_mode.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/inkgd/plugin.cfg", "res://addons/sky_3d/plugin.cfg", "res://addons/terrain_3d/plugin.cfg", "res://addons/SpacetimeDB/plugin.cfg")

[internationalization]

locale/fallback="et"
locale/translations=PackedStringArray("res://assets/i18n/strings.et.translation", "res://assets/i18n/strings.en.translation")

