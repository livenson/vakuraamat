# Godot
.godot/
*.tmp
# Raw geodata downloads (regenerate with tools/pipeline/fetch_tile.py)
data_raw/
# macOS
.DS_Store
# Blender
*.blend1

# Node modules for the ink compiler
tools/ink/node_modules/
build/
# Generated by the pipeline (make tile); rebuilt, not committed. Tree meshes and impostor atlases
# (make trees, needs Blender and a window) are committed so exports and CI builds have them.
assets/terrain/*/data/
# SpacetimeDB codegen scratch (bindings themselves are committed)
spacetime_bindings/codegen_debug/
# Rust build output of the town module
server/vakuraamat/target/
# Media headlines snapshot for offline play (regenerate with make news-local)
sites/*/news.json
sites/*/news.json.import

# secrets
sketchfab.token
# MCP servers cloned and built locally (make mcp)
tools/mcp/sketchfab-mcp-server/
# Sketchfab candidates under review (tools/mcp/sketchfab.sh), not vendored
assets/vendor/_review/
